@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>E-Ticaret - Giriş Yap</title>

    <link href="~/sbadmin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/sbadmin/css/sb-admin-2.min.css" rel="stylesheet">
</head>
<body class="bg-gradient-primary">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-6 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Giriş Ekranı</h1>
                                    </div>

                                    <div class="form-group">
                                        <input type="text" class="form-control form-control-user" id="txtUserName" placeholder="Kullanıcı Adı">
                                    </div>
                                    <div class="form-group">
                                        <input type="password" class="form-control form-control-user" id="txtPassword" placeholder="Parola">
                                    </div>
                                    
                                    <button class="btn btn-primary btn-user btn-block font-weight-bold" id="btnLogin">
                                        Giriş Yap
                                    </button>

                                    <hr>
                                    <div id="divResult" style="display:none;"></div>

                                    <div class="text-center mt-3">
                                        <a class="small font-weight-bold text-primary" href="/Home/Register" style="font-size:15px;">Henüz hesabın yok mu? Yeni Hesap Oluştur!</a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/sbadmin/vendor/jquery/jquery.min.js"></script>
    <script src="~/sbadmin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/sbadmin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/sbadmin/js/sb-admin-2.min.js"></script>

    <script>
            
            function parseJwt(token) {
                try {
                    var base64Url = token.split('.')[1];
                    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                    }).join(''));
                    return JSON.parse(jsonPayload);
                } catch (e) { return null; }
            }

            $(document).ready(function(){
                var apiBaseUrl="@ViewBag.ApiBaseURL";

                if (localStorage.getItem("token")) {
                    
                    window.location.replace("/Home/MainPage");
                }

                $("#btnLogin").click(function(){
                    if(!$("#txtUserName").val() || !$("#txtPassword").val()){
                        $("#divResult").show().removeClass().addClass("alert alert-danger").html("Lütfen Kullanıcı Adı ve Parola giriniz!").fadeOut(3000);
                        return false;
                    }

                    var login = { UserName: $("#txtUserName").val(), Password: $("#txtPassword").val() };
                    $("#btnLogin").prop("disabled", true).text("Giriş Yapılıyor...");

                    $.ajax({
                        url: apiBaseUrl + "/User/SignIn",
                        type: "POST",
                        data: JSON.stringify(login),
                        contentType: "application/json",
                        success: function (d) {
                            if (d.status){
                                localStorage.setItem("token", d.message);
                            
                                
                                location.href = "/Home/MainPage";
                            
                            } else {
                                $("#divResult").show().removeClass().addClass("alert alert-danger mt-3").html(d.message).fadeOut(3000);
                                $("#btnLogin").prop("disabled", false).text("Giriş Yap");
                            }
                        },
                        error: function () {
                            $("#divResult").show().removeClass().addClass("alert alert-danger mt-3").html("Bağlantı hatası yaşandı!").fadeOut(3000);
                            $("#btnLogin").prop("disabled", false).text("Giriş Yap");
                        }
                    });
                });
            });
    </script>
</body>
</html>