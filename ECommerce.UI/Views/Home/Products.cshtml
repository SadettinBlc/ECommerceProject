@{
    ViewData["Title"] = "Ürün Yönetimi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Ürün Yönetimi</h1>
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Tüm Ürünler</h6>
            <button class="btn btn-sm btn-success" id="btnShowAddModal"><i class="fas fa-plus"></i> Yeni Ürün Ekle</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="productTable" width="100%" cellspacing="0">
                    <thead class="bg-light">
                        <tr>
                            <th>ID</th>
                            <th>Fotoğraf</th>
                            <th>Kategori</th>
                            <th>Ürün Adı</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="productList">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Ürün Ekle</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtProductId">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="font-weight-bold">Ürün Adı</label>
                        <input type="text" class="form-control" id="txtName">
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="font-weight-bold">Kategori</label>
                        <select class="form-control" id="cbCategory"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="font-weight-bold">Fiyat (₺)</label>
                        <input type="number" class="form-control" id="txtPrice" step="0.01">
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="font-weight-bold">Stok Adedi</label>
                        <input type="number" class="form-control" id="txtStock">
                    </div>
                </div>
                
                <div class="form-group border rounded p-3 bg-light">
                    <label class="font-weight-bold">Ürün Görselleri (Sürükle bırak veya seç)</label>
                    <input type="file" class="form-control-file mb-3" id="fileProductImage" accept="image/*" multiple>
                    
                    <div id="uploadResult" class="mb-2 font-weight-bold" style="display:none;"></div>
                    
                    <label class="font-weight-bold text-muted small">Yüklü Resimler:</label>
                    <div id="existingImagesContainer" class="d-flex flex-wrap">
                    </div>
                    <input type="hidden" id="txtPhotoUrl">
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Açıklama</label>
                    <textarea class="form-control" id="txtDescription" rows="4"></textarea>
                </div>
                <div class="form-group">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="chkIsActive" checked>
                        <label class="custom-control-label font-weight-bold" for="chkIsActive">Aktif mi?</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="btnSaveProduct">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="featureModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Ürün Özellikleri: <span id="lblFeatureProductName"></span></h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtFeatureProductId">
                <div class="row mb-3">
                    <div class="col-5">
                        <input type="text" class="form-control form-control-sm" id="txtFeatureName" placeholder="Örn: RAM">
                    </div>
                    <div class="col-5">
                        <input type="text" class="form-control form-control-sm" id="txtFeatureValue" placeholder="Örn: 16 GB">
                    </div>
                    <div class="col-2">
                        <button class="btn btn-sm btn-success w-100" id="btnAddFeature"><i class="fas fa-plus"></i></button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="bg-light">
                            <tr>
                                <th>Özellik</th>
                                <th>Değer</th>
                                <th>Sil</th>
                            </tr>
                        </thead>
                        <tbody id="featureList">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var apiBaseUrl = "@ViewBag.ApiBaseURL";
            if (!apiBaseUrl || apiBaseUrl === "") { apiBaseUrl = "https://localhost:7073/api"; }
            var token = localStorage.getItem("token");
            
            
            var uploadedPhotos = [];

            function LoadCategories() {
                $.ajax({
                    url: apiBaseUrl + "/Category/List",
                    type: "GET",
                    success: function (d) {
                        $("#cbCategory").empty();
                        $.each(d, function (i, c) {
                            $("#cbCategory").append('<option value="' + (c.id || c.Id) + '">' + (c.name || c.Name) + '</option>');
                        });
                    }
                });
            }

            function LoadProducts() {
                $.ajax({
                    url: apiBaseUrl + "/Product/List?page=1&pageSize=1000&showAll=true",
                    type: "GET",
                    success: function (d) {
                        var products = d.items || d.Items || d;
                        $("#productList").empty();
                        $.each(products, function (i, p) {
                            var catName = p.category ? (p.category.name || p.category.Name) : "Kategorisiz";
                            
                            var rawPhotos = p.photoUrl || p.PhotoUrl || "";
                            var firstPhoto = rawPhotos.split(',')[0];
                            
                            var imgPath = firstPhoto ?
                                (apiBaseUrl.replace('/api', '') + "/" + firstPhoto.replace(/\\/g, '/')) :
                                "/images/no-image.png";

                            var statusBadge = (p.isActive || p.IsActive) ? '<span class="badge badge-success">Aktif</span>' : '<span class="badge badge-danger">Pasif</span>';
                            
                            var row = `<tr>
                                <td>${p.id || p.Id}</td>
                                <td><img src="${imgPath}" style="width:50px; height:50px; object-fit:cover;" class="rounded shadow-sm"></td>
                                <td>${catName}</td>
                                <td class="font-weight-bold">${p.name || p.Name}</td>
                                <td class="text-success font-weight-bold">₺${p.price || p.Price}</td>
                                <td>${p.stock || p.Stock}</td>
                                <td>${statusBadge}</td>
                                <td>
                                    <button class="btn btn-info btn-sm btnFeatures" data-id="${p.id || p.Id}" data-name="${p.name || p.Name}"><i class="fas fa-list"></i> Özellikler</button>
                                    <button class="btn btn-primary btn-sm btnEdit" data-id="${p.id || p.Id}"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-danger btn-sm btnDelete" data-id="${p.id || p.Id}"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>`;
                            $("#productList").append(row);
                        });
                    }
                });
            }

            LoadCategories();
            LoadProducts();

            
            function RenderPhotos() {
                $("#existingImagesContainer").empty();
                
                if (uploadedPhotos.length === 0) {
                    $("#existingImagesContainer").html('<span class="text-muted small">Henüz resim yüklenmedi.</span>');
                } else {
                    $.each(uploadedPhotos, function(index, url) {
                        if(url && url.trim() !== "") {
                            var fullUrl = url.includes("http") ? url : apiBaseUrl.replace('/api', '') + "/" + url.replace(/\\/g, '/');
                            
                            var imgHtml = `
                                <div class="position-relative mr-2 mb-2" style="width: 80px; height: 80px;">
                                    <img src="${fullUrl}" class="img-thumbnail" style="width: 100%; height: 100%; object-fit: cover;">
                                    <button type="button" class="btn btn-danger btn-sm position-absolute btnRemovePhoto" data-index="${index}" style="top: -8px; right: -8px; border-radius: 50%; padding: 0; width: 22px; height: 22px; line-height: 1;" title="Sil">
                                        <i class="fas fa-times" style="font-size: 12px;"></i>
                                    </button>
                                </div>
                            `;
                            $("#existingImagesContainer").append(imgHtml);
                        }
                    });
                }
                
                
                $("#txtPhotoUrl").val(uploadedPhotos.join(','));
            }

            
            $(document).on("click", ".btnRemovePhoto", function() {
                var idx = $(this).data("index");
                uploadedPhotos.splice(idx, 1); // Diziden çıkar
                RenderPhotos(); // Ekranı yenile
            });

            $("#fileProductImage").change(function () {
                var files = $(this).prop('files');
                if (files.length > 0) {
                    $("#uploadResult").show().removeClass().addClass("text-info").html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor (0/' + files.length + ')...');
                    var uploadCount = 0;
                    var tempUploaded = [];

                    $.each(files, function(i, file) {
                        var formData = new FormData();
                        formData.append("File", file);

                        $.ajax({
                            url: apiBaseUrl + "/Upload/UploadImage",
                            type: "POST",
                            headers: { "Authorization": "Bearer " + token },
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (data) {
                                if(data && data.url) {
                                    tempUploaded.push(data.url);
                                }
                            },
                            complete: function() {
                                uploadCount++;
                                $("#uploadResult").html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor (' + uploadCount + '/' + files.length + ')...');
                                
                                if(uploadCount === files.length) {
                                    // Yüklenenleri mevcut listeye ekle
                                    $.each(tempUploaded, function(idx, val) {
                                        uploadedPhotos.push(val);
                                    });
                                    
                                    RenderPhotos();
                                    
                                    $("#uploadResult").removeClass().addClass("text-success").html('<i class="fas fa-check"></i> ' + files.length + ' resim eklendi!').delay(3000).fadeOut();
                                    $("#fileProductImage").val(""); // Inputu temizle
                                }
                            }
                        });
                    });
                }
            });

            $("#btnShowAddModal").click(function () {
                $("#txtProductId").val("");
                $("#txtName").val("");
                $("#txtPrice").val("");
                $("#txtStock").val("");
                $("#txtDescription").val("");
                $("#txtPhotoUrl").val("");
                $("#fileProductImage").val("");
                $("#chkIsActive").prop("checked", true);
                $("#uploadResult").hide();
                
                uploadedPhotos = [];
                RenderPhotos();

                $("#modalTitle").text("Yeni Ürün Ekle");
                $("#productModal").modal("show");
            });

            $("#btnSaveProduct").click(function () {
                var id = $("#txtProductId").val();
                var isUpdate = id !== "";
                var endpoint = isUpdate ? "/Product/Update" : "/Product/Add";
                var method = isUpdate ? "PUT" : "POST";

                var dto = {
                    Name: $("#txtName").val(),
                    Description: $("#txtDescription").val(),
                    Price: parseFloat($("#txtPrice").val()) || 0,
                    Stock: parseInt($("#txtStock").val()) || 0,
                    CategoryId: parseInt($("#cbCategory").val()),
                    PhotoUrl: $("#txtPhotoUrl").val(),
                    IsActive: $("#chkIsActive").is(":checked")
                };

                if (isUpdate) { dto.Id = parseInt(id); }

                $.ajax({
                    url: apiBaseUrl + endpoint,
                    type: method,
                    headers: { "Authorization": "Bearer " + token },
                    contentType: "application/json",
                    data: JSON.stringify(dto),
                    success: function (d) {
                        if (d.status) {
                            $("#productModal").modal("hide");
                            LoadProducts();
                        } else {
                            alert(d.message);
                        }
                    }
                });
            });

            $(document).on("click", ".btnEdit", function () {
                var id = $(this).data("id");
                $.ajax({
                    url: apiBaseUrl + "/Product/GetById/" + id,
                    type: "GET",
                    success: function (d) {
                        $("#txtProductId").val(d.id || d.Id);
                        $("#txtName").val(d.name || d.Name);
                        $("#cbCategory").val(d.categoryId || d.CategoryId);
                        $("#txtPrice").val(d.price || d.Price);
                        $("#txtStock").val(d.stock || d.Stock);
                        $("#txtDescription").val(d.description || d.Description);
                        $("#chkIsActive").prop("checked", d.isActive || d.IsActive);
                        
                        $("#uploadResult").hide();
                        $("#fileProductImage").val("");
                        
                        
                        uploadedPhotos = [];
                        var rawPhotos = d.photoUrl || d.PhotoUrl || "";
                        if(rawPhotos !== "") {
                            uploadedPhotos = rawPhotos.split(',').filter(x => x.trim() !== "");
                        }
                        RenderPhotos();
                        
                        $("#modalTitle").text("Ürün Düzenle");
                        $("#productModal").modal("show");
                    }
                });
            });

            $(document).on("click", ".btnDelete", function () {
                var id = $(this).data("id");
                if (confirm("Bu ürünü silmek istediğinize emin misiniz?")) {
                    $.ajax({
                        url: apiBaseUrl + "/Product/Delete/" + id,
                        type: "DELETE",
                        headers: { "Authorization": "Bearer " + token },
                        success: function (d) {
                            if (d.status) { LoadProducts(); }
                            else { alert(d.message); }
                        }
                    });
                }
            });

            function LoadFeatures(productId) {
                $.ajax({
                    url: apiBaseUrl + "/Product/GetById/" + productId,
                    type: "GET",
                    success: function (d) {
                        $("#featureList").empty();
                        var features = d.productFeatures || d.ProductFeatures || [];
                        $.each(features, function (i, f) {
                            var row = `<tr>
                                <td>${f.name || f.FeatureName}</td>
                                <td>${f.value || f.FeatureValue}</td>
                                <td class="text-center">
                                    <button class="btn btn-danger btn-sm btnDeleteFeature" data-id="${f.id || f.Id}" data-pid="${productId}"><i class="fas fa-times"></i></button>
                                </td>
                            </tr>`;
                            $("#featureList").append(row);
                        });
                    }
                });
            }

            $(document).on("click", ".btnFeatures", function () {
                var id = $(this).data("id");
                var name = $(this).data("name");
                $("#txtFeatureProductId").val(id);
                $("#lblFeatureProductName").text(name);
                $("#txtFeatureName").val("");
                $("#txtFeatureValue").val("");
                LoadFeatures(id);
                $("#featureModal").modal("show");
            });

            $("#btnAddFeature").click(function () {
                var pId = $("#txtFeatureProductId").val();
                var fName = $("#txtFeatureName").val();
                var fVal = $("#txtFeatureValue").val();

                if (!fName || !fVal) { alert("Lütfen özellik adı ve değerini girin."); return; }

                var dto = { ProductId: parseInt(pId), FeatureName: fName, FeatureValue: fVal };

                $.ajax({
                    url: apiBaseUrl + "/Product/AddFeature",
                    type: "POST",
                    headers: { "Authorization": "Bearer " + token },
                    contentType: "application/json",
                    data: JSON.stringify(dto),
                    success: function (d) {
                        if (d.status) {
                            $("#txtFeatureName").val("");
                            $("#txtFeatureValue").val("");
                            LoadFeatures(pId);
                        } else { alert(d.message); }
                    }
                });
            });

            $(document).on("click", ".btnDeleteFeature", function () {
                var fId = $(this).data("id");
                var pId = $(this).data("pid");
                if (confirm("Özelliği silmek istediğinize emin misiniz?")) {
                    $.ajax({
                        url: apiBaseUrl + "/Product/DeleteFeature/" + fId,
                        type: "DELETE",
                        headers: { "Authorization": "Bearer " + token },
                        success: function (d) {
                            if (d.status) { LoadFeatures(pId); }
                            else { alert(d.message); }
                        }
                    });
                }
            });
        });
    </script>
}