@{
    ViewData["Title"] = "Main Page";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<div class="row mb-4 mt-2">
    <div class="col-12 border-bottom border-secondary pb-3">
        <h2 class="font-weight-bold text-light m-0" style="letter-spacing: 1px;">
            <i class="fas fa-gem text-custom mr-2"></i> Premium Collection
        </h2>
        <p class="text-muted mt-2 mb-0" style="font-size: 1.1rem;">
            Discover our exclusive range of high-end tech and gaming gear curated just for you.
        </p>
    </div>
</div>

<div class="card card-custom shadow-sm mb-4 p-3">
    <div class="row">
        <div class="col-md-4 mb-2 mb-md-0">
            <div class="input-group">
                <input type="text" id="txtSearch" class="form-control bg-dark text-light border-secondary" placeholder="Search products...">
                <div class="input-group-append">
                    <button class="btn btn-outline-warning" type="button" id="btnSearch"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-2 mb-md-0">
            <select id="cbCategories" class="form-control bg-dark text-light border-secondary">
                <option value="">All Categories</option>
            </select>
        </div>
        <div class="col-md-4">
            <select id="cbSortBy" class="form-control bg-dark text-light border-secondary">
                <option value="">Sort By: Newest First</option>
                <option value="price_asc">Price: Low to High</option>
                <option value="price_desc">Price: High to Low</option>
                <option value="name_asc">Name: A to Z</option>
                <option value="name_desc">Name: Z to A</option>
            </select>
        </div>
    </div>
    
    <div class="row mt-3" id="featureFilters" style="display:none;">
        <div class="col-12">
            <div class="p-3 border border-secondary rounded bg-dark" id="featureCheckboxes">
            </div>
        </div>
    </div>
</div>

<div class="row" id="productContainer">
    <div class="col-12 text-center mt-5">
        <div class="spinner-border text-custom" role="status"></div>
        <h5 class="mt-3">Products are loading...</h5>
    </div>
</div>

<div class="row mt-4 mb-5">
    <div class="col-12 text-center">
        <button id="btnLoadMore" class="btn btn-outline-warning font-weight-bold px-5 py-2 shadow-sm" style="display:none; border-radius: 25px;">
            <i class="fas fa-chevron-down"></i> Load More
        </button>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var apiBaseUrl = "@ViewBag.ApiBaseURL";
            if (!apiBaseUrl || apiBaseUrl === "") { apiBaseUrl = "https://localhost:7073/api"; }
            var token = localStorage.getItem("token");
            var myFavoriteIds = [];
            
            var currentPage = 1;
            var pageSize = 12;

            function showNotification(message, isSuccess) {
                var bgColor = isSuccess ? "bg-success" : "bg-danger";
                var toastHtml = `<div class="toast-notification ${bgColor} text-white px-4 py-3 rounded shadow-lg" style="position: fixed; bottom: 30px; right: 30px; z-index: 9999; display: none; font-weight: bold;">
                                    <i class="fas ${isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}
                                 </div>`;
                var $toast = $(toastHtml).appendTo("body");
                $toast.fadeIn(400).delay(2500).fadeOut(400, function() { $(this).remove(); });
            }

            function LoadFavoritesAndProducts() {
                if(!token) {
                    LoadCategories();
                    LoadProducts(false);
                    return;
                }
                
                $.ajax({
                    url: apiBaseUrl + "/Favorite/GetMyFavorites",
                    type: "GET",
                    headers: { "Authorization": "Bearer " + token },
                    success: function (d) {
                        myFavoriteIds = [];
                        if (d && d.length > 0) {
                            $.each(d, function(i, p) { myFavoriteIds.push(p.id || p.Id); });
                        }
                        LoadCategories();
                        LoadProducts(false);
                    },
                    error: function() {
                        myFavoriteIds = [];
                        LoadCategories();
                        LoadProducts(false);
                    }
                });
            }

            function LoadCategories() {
                if ($("#cbCategories option").length > 1) return;
                $.ajax({
                    url: apiBaseUrl + "/Category/List",
                    type: "GET",
                    success: function (d) {
                        $.each(d, function (i, c) {
                            if(c.isActive || c.IsActive) {
                                $("#cbCategories").append('<option value="' + (c.id || c.Id) + '">' + (c.name || c.Name) + '</option>');
                            }
                        });
                    }
                });
            }

            function LoadProducts(isLoadMore) {
                if (!isLoadMore) {
                    currentPage = 1;
                    $("#productContainer").html('<div class="col-12 text-center mt-5"><div class="spinner-border text-custom" role="status"></div><h5 class="mt-3">Loading...</h5></div>');
                    $("#btnLoadMore").hide();
                } else {
                    $("#btnLoadMore").prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Loading...');
                }

                var searchVal = $("#txtSearch").val();
                var catId = $("#cbCategories").val();
                var sortVal = $("#cbSortBy").val();
                var checkedFeatures = $(".feature-chk:checked").map(function(){ return $(this).val(); }).get().join(',');

                var requestUrl = apiBaseUrl + "/Product/List?page=" + currentPage + "&pageSize=" + pageSize;
                if(searchVal) requestUrl += "&search=" + encodeURIComponent(searchVal);
                if(catId) requestUrl += "&categoryId=" + catId;
                if(sortVal) requestUrl += "&sortBy=" + sortVal;
                if(checkedFeatures) requestUrl += "&features=" + encodeURIComponent(checkedFeatures);

                $.ajax({
                    url: requestUrl,
                    type: "GET",
                    success: function (d) {
                        if (!isLoadMore) { $("#productContainer").empty(); }

                        var products = d.items || d.Items || [];
                        var totalPages = d.totalPages || d.TotalPages || 1;

                        if (products.length === 0 && !isLoadMore) {
                            $("#productContainer").html('<div class="col-12 alert alert-warning bg-dark text-warning border-warning">No products found matching your criteria.</div>');
                            $("#btnLoadMore").hide();
                            return;
                        }

                        $.each(products, function (i, p) {
                            var rawPhotos = p.photoUrl || p.PhotoUrl || "";
                            var firstPhoto = rawPhotos.split(',')[0];
                            
                            var imgPath = firstPhoto ?
                                (apiBaseUrl.replace('/api', '') + "/" + firstPhoto.replace(/\\/g, '/')) :
                                "https://dummyimage.com/400x300/1e1e1e/d4af37&text=No+Image";
                                
                            var pName = p.name || p.Name;
                            var pPrice = p.price || p.Price;
                            var pId = p.id || p.Id;
                            var pStock = p.stock || p.Stock || 0;

                            var isFav = myFavoriteIds.includes(pId);
                            var btnFavClass = isFav ? "btn-danger is-fav" : "btn-outline-danger";
                            var iconFavClass = isFav ? "fas fa-heart" : "far fa-heart";

                            var stockBadge = "";
                            if(pStock > 0 && pStock <= 5) {
                                stockBadge = `<span class="badge badge-danger mb-1 shadow-sm p-2 text-left" style="font-size: 0.75rem;"><i class="fas fa-fire"></i> Low Stock (Only ${pStock} left)</span>`;
                            } else if (pStock === 0) {
                                stockBadge = `<span class="badge badge-dark text-light mb-1 shadow-sm p-2 text-left" style="font-size: 0.75rem;"><i class="fas fa-times"></i> Out of Stock</span>`;
                            }

                            var cardHtml = `
                                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                                    <div class="card card-custom h-100 shadow">
                                        <div class="position-relative">
                                            
                                            <div class="position-absolute d-flex flex-column" style="top: 10px; left: 10px; z-index: 10;">
                                                ${stockBadge}
                                                <span class="badge badge-warning text-dark shadow-sm p-2 text-left" id="badge-popular-${pId}" style="display:none; font-size: 0.75rem;"><i class="fas fa-star"></i> Popular Product</span>
                                            </div>

                                            <img src="${imgPath}" class="card-img-top" style="height: 220px; width: 100%; object-fit: contain; background-color: #1a1a1a; padding: 10px;" alt="${pName}">
                                            
                                            <button class="btn btn-sm ${btnFavClass} position-absolute btnAddFav shadow" data-id="${pId}" style="top: 10px; right: 10px; border-radius: 50%; width: 35px; height: 35px; padding: 0; z-index: 10;">
                                                <i class="${iconFavClass}"></i>
                                            </button>
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title font-weight-bold mb-1">${pName}</h5>
                                            <div class="mb-2 rating-container-${pId}" style="font-size: 0.85rem;">
                                                <span class="spinner-border spinner-border-sm text-custom" role="status"></span>
                                            </div>
                                            <h4 class="text-custom mt-auto mb-3">₺${pPrice}</h4>
                                            <div class="row">
                                                <div class="col-6 pr-1">
                                                    <a href="/Home/ProductDetails/${pId}" class="btn btn-outline-light btn-sm btn-block"><i class="fas fa-search"></i> Details</a>
                                                </div>
                                                <div class="col-6 pl-1">
                                                    <button class="btn btn-primary btn-sm btn-block btnAddToCartList" data-id="${pId}" ${pStock === 0 ? "disabled" : ""}><i class="fas fa-cart-plus"></i> Add</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;
                            $("#productContainer").append(cardHtml);

                            $.ajax({
                                url: apiBaseUrl + "/Review/GetProductReviews/" + pId,
                                type: "GET",
                                success: function(rData) {
                                    var avg = rData.averageRating || rData.AverageRating || 0;
                                    var count = rData.totalReviews || rData.TotalReviews || 0;
                                    if(count === 0) {
                                        $(".rating-container-" + pId).html('<span class="text-muted">No reviews</span>');
                                    } else {
                                        var stars = "⭐".repeat(Math.round(avg));
                                        $(".rating-container-" + pId).html('<span class="text-warning">' + stars + '</span> <span class="text-muted">(' + avg + ')</span>');
                                        
                                        if(avg >= 4 && count >= 2) {
                                            $("#badge-popular-" + pId).fadeIn();
                                        }
                                    }
                                }
                            });
                        });

                        if (currentPage >= totalPages) {
                            $("#btnLoadMore").hide();
                        } else {
                            $("#btnLoadMore").show().prop("disabled", false).html('<i class="fas fa-chevron-down"></i> Load More');
                        }
                    }
                });
            }

            LoadFavoritesAndProducts();

            $("#cbCategories").change(function () {
                var catId = $(this).val();
                if(!catId) {
                    $("#featureFilters").slideUp();
                    $("#featureCheckboxes").empty();
                    LoadProducts(false);
                    return;
                }
                $.ajax({
                    url: apiBaseUrl + "/Product/GetCategoryFeatures/" + catId,
                    type: "GET",
                    success: function(data) {
                        $("#featureCheckboxes").empty();
                        if(data && data.length > 0) {
                            var html = '<h6 class="text-custom font-weight-bold mb-3 border-bottom border-secondary pb-2"><i class="fas fa-filter"></i> Filter by Specifications</h6><div class="row">';
                            $.each(data, function(i, group) {
                                html += '<div class="col-md-3 col-sm-6 mb-3"><strong class="text-light d-block mb-2">' + group.name + '</strong>';
                                $.each(group.values, function(j, val) {
                                    html += `<div class="custom-control custom-checkbox mb-1">
                                                <input type="checkbox" class="custom-control-input feature-chk" id="chk_${i}_${j}" value="${val}">
                                                <label class="custom-control-label text-muted" style="cursor:pointer;" for="chk_${i}_${j}">${val}</label>
                                             </div>`;
                                });
                                html += '</div>';
                            });
                            html += '</div>';
                            $("#featureCheckboxes").html(html);
                            $("#featureFilters").slideDown();
                        } else {
                            $("#featureFilters").slideUp();
                        }
                        LoadProducts(false);
                    }
                });
            });

            $(document).on("change", ".feature-chk", function() { LoadProducts(false); });
            $("#btnSearch").click(function () { LoadProducts(false); });
            $("#txtSearch").keypress(function (e) { if (e.which == 13) { LoadProducts(false); return false; } });
            $("#cbSortBy").change(function () { LoadProducts(false); });

            $("#btnLoadMore").click(function () {
                currentPage++;
                LoadProducts(true);
            });

            $(document).on("click", ".btnAddFav", function() {
                if(!token) { showNotification("You must be logged in to manage favorites.", false); return; }
                var btn = $(this);
                var pId = btn.data("id");
                var isFavorite = btn.hasClass("is-fav");
                
                btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i>');

                if (isFavorite) {
                    $.ajax({
                        url: apiBaseUrl + "/Favorite/Remove/" + pId,
                        type: "DELETE",
                        headers: { "Authorization": "Bearer " + token },
                        success: function(d) {
                            if(d.status) {
                                btn.removeClass("btn-danger is-fav").addClass("btn-outline-danger").html('<i class="far fa-heart"></i>');
                                myFavoriteIds = myFavoriteIds.filter(id => id !== pId);
                                showNotification("Removed from favorites.", true);
                            } else {
                                showNotification(d.message, false);
                                btn.html('<i class="fas fa-heart"></i>');
                            }
                            btn.prop("disabled", false);
                        }
                    });
                } else {
                    $.ajax({
                        url: apiBaseUrl + "/Favorite/Add?productId=" + pId,
                        type: "POST",
                        headers: { "Authorization": "Bearer " + token },
                        success: function(d) {
                            if(d.status) {
                                btn.removeClass("btn-outline-danger").addClass("btn-danger is-fav").html('<i class="fas fa-heart"></i>');
                                myFavoriteIds.push(pId);
                                showNotification("Added to favorites!", true);
                            } else {
                                showNotification(d.message, false);
                                btn.html('<i class="far fa-heart"></i>');
                            }
                            btn.prop("disabled", false);
                        }
                    });
                }
            });

            $(document).on("click", ".btnAddToCartList", function() {
                if(!token) { showNotification("You must be logged in to add to basket.", false); return; }
                var btn = $(this);
                var pId = btn.data("id");
                btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: apiBaseUrl + "/Basket/AddItem?productId=" + pId + "&quantity=1",
                    type: "POST",
                    headers: { "Authorization": "Bearer " + token },
                    success: function(d) {
                        if(d.status) {
                            showNotification("Item added to basket!", true);
                            if(typeof window.UpdateCartCount === "function") window.UpdateCartCount();
                            btn.removeClass("btn-primary").addClass("btn-success").html('<i class="fas fa-check"></i> Added');
                            setTimeout(function() {
                                btn.removeClass("btn-success").addClass("btn-primary").html('<i class="fas fa-cart-plus"></i> Add');
                                btn.prop("disabled", false);
                            }, 2000);
                        } else {
                            showNotification(d.message, false);
                            btn.prop("disabled", false).html('<i class="fas fa-cart-plus"></i> Add');
                        }
                    },
                    error: function() {
                        showNotification("Connection error!", false);
                        btn.prop("disabled", false).html('<i class="fas fa-cart-plus"></i> Add');
                    }
                });
            });
        });
    </script>
}