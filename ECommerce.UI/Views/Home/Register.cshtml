@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>E-Ticaret - Kayıt Ol</title>

    <link href="~/sbadmin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/sbadmin/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-primary">

    <div class="container">
        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-lg-5 d-none d-lg-block bg-register-image"></div>
                    <div class="col-lg-7">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">Yeni Hesap Oluştur!</h1>
                            </div>
                            <div class="user">
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        <input type="text" class="form-control form-control-user" id="txtFullName" placeholder="Adınız Soyadınız">
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="text" class="form-control form-control-user" id="txtUserName" placeholder="Kullanıcı Adı">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <input type="email" class="form-control form-control-user" id="txtEmail" placeholder="E-Posta Adresi">
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6 mb-3 mb-sm-0">
                                        <input type="text" class="form-control form-control-user" id="txtPhone" placeholder="Telefon Numarası">
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="password" class="form-control form-control-user" id="txtPassword" placeholder="Şifre Belirleyin">
                                    </div>
                                </div>
                                <button id="btnRegister" class="btn btn-primary btn-user btn-block font-weight-bold">
                                    Hesabı Oluştur
                                </button>
                            </div>
                            <hr>
                            <div id="registerResult" class="alert text-center" style="display:none;"></div>
                            <div class="text-center">
                                <a class="small" href="/Login">Zaten bir hesabın var mı? Giriş Yap!</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/sbadmin/vendor/jquery/jquery.min.js"></script>
    <script src="~/sbadmin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/sbadmin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/sbadmin/js/sb-admin-2.min.js"></script>

    <script>
            $(document).ready(function () {
                var apiBaseUrl = "@ViewBag.ApiBaseURL";

                
                if (localStorage.getItem("token")) {
                    window.location.replace("/Home/Index");
                }

                $("#btnRegister").click(function () {
                    var dto = {
                        userName: $("#txtUserName").val(),
                        email: $("#txtEmail").val(),
                        fullName: $("#txtFullName").val(),
                        phoneNumber: $("#txtPhone").val(),
                        password: $("#txtPassword").val()
                    };

                    
                    if (!dto.userName || !dto.email || !dto.password || !dto.fullName) {
                        $("#registerResult").show().removeClass().addClass("alert-warning").text("Lütfen zorunlu alanları doldurun!");
                        return;
                    }

                    $("#btnRegister").prop("disabled", true).text("Kaydediliyor...");

                    $.ajax({
                        url: apiBaseUrl + "/User/Add",
                        type: "POST",
                        data: JSON.stringify(dto),
                        contentType: "application/json",
                        success: function (d) {
                            if (d.status) {
                                $("#registerResult").show().removeClass("alert-warning alert-danger").addClass("alert-success").text("Kayıt Başarılı! Giriş sayfasına yönlendiriliyorsunuz...");
                                
                                setTimeout(function () { window.location.href = "/Login"; }, 2000);
                            } else {
                                $("#registerResult").show().removeClass("alert-warning alert-success").addClass("alert-danger").text(d.message);
                                $("#btnRegister").prop("disabled", false).text("Hesabı Oluştur");
                            }
                        },
                        error: function () {
                            $("#registerResult").show().removeClass("alert-warning alert-success").addClass("alert-danger").text("Bağlantı Hatası!");
                            $("#btnRegister").prop("disabled", false).text("Hesabı Oluştur");
                        }
                    });
                });
            });
    </script>
</body>
</html>